# Python
__pycache__/
*.py[cod]
*$py.class

# Virtual environment
venv/
myenv/
.env
.env.*
# ...окрім зразка. Саме через .env.* його ніколи й не було в репозиторії,
# хоча README казав «cp .env.example .env». Секретів у ньому немає — самі
# назви змінних і пояснення, навіщо кожна.
!.env.example
.venv/

# IDEs and editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# OS files
.DS_Store
Thumbs.db

# Flask / Render
instance/
*.log

# Secrets
credentials.json
*/secret_*.json
.phase0-backup/

# Заявки (Phase 0)
leads.db
leads-fallback.jsonl

# Кеш геокодера (Phase 2) — відтворюється сам, у репозиторії не потрібен
geocache.db
geocache.db-wal
geocache.db-shm

# Тимчасова тека для файлів, які треба видалити вручну
_to_delete/

# Логи застосунку (Phase 4)
logs/

# Майстер-файли відео. Сайт віддає ЛИШЕ static/videos/derived/ — вихідні
# ролики потрібні тільки для перекодування, і то раз на кілька місяців.
# У репозиторії вони важили 42 МБ із 45: кожен клон і кожен git pull тягнув
# їх заново, а на сервері вони просто лежали й займали диск.
# Тримай майстри локально або в хмарі, але не в git.
static/videos/*.mp4
static/videos/*.mov
!static/videos/derived/

# сміття від застряглих git-локів на мосту та .bak від sed -i
_gitlocks/
*.bak
