# Скопіювати в .env і заповнити:  cp .env.example .env
#
# Жодна змінна не є обов'язковою, щоб сайт піднявся, — у config.py на все
# є значення за замовчуванням. Саме тому нічого не падає, коли змінної
# немає: сайт просто поводиться як девелоперський. Перед деплоєм пройти
# по всьому файлу.
# .env у .gitignore і не має потрапляти в репозиторій НІКОЛИ.

# ─── Обов'язкове на бойовому ──────────────────────────────────────────
# Підпис сесій. Типове значення в config.py — рядок "dev-secret-key",
# і він лежить у публічному репозиторії. Свій згенерувати так:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Абсолютна адреса сайту. З неї будуються КОЖЕН canonical, кожен
# hreflang і кожен рядок sitemap.xml. Символ у символ: https чи http,
# з www чи без, БЕЗ слеша в кінці.
SITE_URL=https://vezemo24.com

FLASK_DEBUG=0

# ─── Телефон ──────────────────────────────────────────────────────────
# Доки PHONE_E164 не заданий, PHONE_IS_PLACEHOLDER = True і телефон
# зникає зі структурованих даних: Google не отримує номера взагалі.
PHONE_E164=+380XXXXXXXXX
PHONE_DISPLAY=+380 (XX) XXX-XX-XX
CONTACT_EMAIL=info@vezemo24.com

# ─── Заявки ───────────────────────────────────────────────────────────
# Куди приходять нові заявки. Без них заявка збережеться в базу, але
# ніхто про неї не дізнається.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Кнопки месенджерів у шапці. Порожнє — кнопки просто немає.
TELEGRAM_URL=https://t.me/vezemo24
VIBER_URL=

# ─── Аналітика ────────────────────────────────────────────────────────
# Тег мовчить, доки жодне з двох не задане. Ставити ДО запуску:
# перший тиждень нового сайту буває один раз.
GA4_MEASUREMENT_ID=
GTM_CONTAINER_ID=
GOOGLE_ADS_ID=
GOOGLE_ADS_CONVERSION_LABEL=

# ─── Моніторинг ───────────────────────────────────────────────────────
# Без DSN Sentry не робить нічого. З ним — падіння й невдалі надсилання
# в Telegram приходять сповіщенням, а не лишаються в логах. Тіло форми
# туди не їде ніколи, див. monitoring.py.
SENTRY_DSN=
SENTRY_ENV=production
SENTRY_RELEASE=

# ─── Інше ─────────────────────────────────────────────────────────────
# Спільний ліміт заявок між воркерами. Порожнє — ліміт у пам'яті
# кожного воркера окремо.
REDIS_URL=

# Ключ Google Maps. Карта працює без нього — через Nominatim/OSRM.
GOOGLE_API=
